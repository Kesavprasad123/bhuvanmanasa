# ===========================================================================
# Wedding App Environment Configuration
# ===========================================================================

# ---------------------------------------------------------------------------
# YouTube Live Stream for the Wedding Ceremony
# Paste your YouTube live stream URL or video ID here:
# Examples:
#   VITE_YOUTUBE_LIVE_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ
#   VITE_YOUTUBE_LIVE_URL=https://youtube.com/live/your_live_stream_id
#   VITE_YOUTUBE_LIVE_URL=https://youtu.be/your_live_stream_id
# During the wedding, place your live stream link here and rebuild/restart.
# ---------------------------------------------------------------------------
VITE_YOUTUBE_LIVE_URL=https://youtu.be/osMXReitz0I?si=Z-F0c7ygR9NUKFbd

# ---------------------------------------------------------------------------
# Accommodation Backend (Supabase) - Cross-Device Live Sync
# To reflect host/admin allocations across all devices (phones & computers):
# 1. Create a free project at https://supabase.com
# 2. In SQL Editor, run `supabase/setup.sql`
# 3. Enter your project URL and anon public key below:
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
